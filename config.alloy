logging {
  level  = "info"
  format = "logfmt"
}

prometheus.remote_write "metrics_hosted_prometheus" {
   endpoint {
      name = "hosted-prometheus"
      url  = "https://prometheus-prod-24-prod-eu-west-2.grafana.net/api/prom/push"

      basic_auth {
        username = "2635605"
        password = local.file.api_key_file.content
      }
   }
}

prometheus.relabel "claustroboard" {
  forward_to = [prometheus.remote_write.metrics_hosted_prometheus.receiver]

  rule {
    action       = "replace"
    target_label = "environment"
    replacement  = sys.env("ENVIRONMENT")
  }
}

prometheus.scrape "claustroboard" {
  scrape_interval = "15s"
  scrape_timeout = "5s"

  targets = [
    { __address__ = "app:8080" },
  ]

  forward_to = [prometheus.relabel.claustroboard.receiver]
}

local.file "api_key_file" {
  filename = "/run/secrets/gcloud_rw_api_key"
  is_secret = true
}
